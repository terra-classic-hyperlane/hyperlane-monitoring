# ---------------------------------------------------------------------------
# tc-monitoring-hyperlane — all variables are OPTIONAL. Without any of them the
# dashboard works from public data: the Terra Classic Hyperlane registry, public
# RPC/LCD endpoints and the validators' public checkpoint buckets.
# ---------------------------------------------------------------------------

# Registry fork/branch (chain metadata, contract addresses, warp routes)
# REGISTRY_URL=https://github.com/terra-classic-hyperlane/hyperlane-registry
# REGISTRY_BRANCH=public-warp

# Private RPCs (server-side only, never sent to the browser). Recommended in production:
# public Solana/BSC RPCs rate-limit the scans and the dashboard degrades to partial data.
# RPC_SOLANAMAINNET=https://mainnet.helius-rpc.com/?api-key=...
# RPC_BSC=https://...
# RPC_ETHEREUM=https://...
# RPC_TERRACLASSIC_LCD=https://...

# Operator (relayer) wallets — defaults are the Terra Classic community relayer
# OPERATOR_TERRACLASSIC=terra1...
# OPERATOR_BSC=0x...
# OPERATOR_ETHEREUM=0x...
# OPERATOR_SOLANAMAINNET=...

# Balance alert thresholds in native units (JSON, partial override allowed)
# BALANCE_THRESHOLDS={"bsc":{"warn":0.05,"critical":0.01},"ethereum":{"warn":0.08,"critical":0.02}}

# Relayer health windows (minutes a message may stay undelivered before warn / down)
# PENDING_WARN_MINUTES=20
# PENDING_DOWN_MINUTES=90

# Validator checkpoint tolerance
# VALIDATOR_LAG_TOLERANCE=1
# VALIDATOR_STALE_MINUTES=60

# Shared snapshot cache (seconds). All visitors share one snapshot.
# SNAPSHOT_TTL_SECONDS=45

# Optional: Prometheus metrics of YOUR relayer/validator (see README "Operator agents").
# RELAYER_METRICS_URL=https://metrics.example.com/relayer/metrics
# VALIDATOR_METRICS_URL=https://metrics.example.com/validator/metrics
# METRICS_AUTH_HEADER=Basic base64(user:pass)
